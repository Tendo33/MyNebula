# MyNebula pipeline configuration.
# Copy to `.env` for local runs (`pnpm sync`). On GitHub Actions the same names
# are read from repository secrets and variables (see README › Deploy).
#
# Every *_BASE_URL takes any OpenAI-compatible endpoint. The defaults point at
# SiliconFlow, so one SiliconFlow key covers both embeddings and the LLM.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# GitHub personal access token that can read your stars and star lists.
# A classic token is simplest. On Actions, store it as the STARS_TOKEN secret.
GITHUB_TOKEN=

# Embeddings: required, they place every repo in the graph.
# The account must have balance (even models priced near zero return 402 otherwise).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# Optional: LLM summaries, tags, and cluster names
# ---------------------------------------------------------------------------

# Leave LLM_API_KEY empty to skip chat models entirely: repos are embedded from
# their description, topics, and README, and the site shows the original text.
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# DeepSeek works the same way:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Language of generated summaries, tags, and cluster names: zh or en.
LLM_OUTPUT_LANGUAGE=zh

# Name new clusters with the LLM (one call per new cluster; names are reused
# while a cluster keeps its members). false = free names from distinctive tags.
GRAPH_LLM_NAMES=false

# ---------------------------------------------------------------------------
# Optional: tuning
# ---------------------------------------------------------------------------

# Upper bound on sizable clusters. Fewer, broader groups when lower.
GRAPH_MAX_CLUSTERS=12

# Repos per embedding request and per saved checkpoint.
SYNC_BATCH_SIZE=100

# Parallel LLM requests. Lower it if your provider rate-limits (HTTP 429).
SYNC_LLM_CONCURRENCY=4

# README characters sent to the LLM and used for embeddings.
SYNC_README_MAX_LENGTH=10000

# Where the incremental cache and the site data live.
# NEBULA_CACHE=data/cache.json.gz
# NEBULA_OUTPUT=frontend/public/data
