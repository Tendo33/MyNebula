# GitHub personal access token that can read your stars (and star lists)
GITHUB_TOKEN=your_github_personal_access_token

# Embeddings (any OpenAI-compatible endpoint)
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# LLM for summaries, tags, and cluster names (leave the key empty to skip)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_OUTPUT_LANGUAGE=zh

# Groups are graph communities; cap how many sizable groups appear
GRAPH_MAX_CLUSTERS=12
# Name new groups with the LLM (one call per group) instead of free tag names
GRAPH_LLM_NAMES=false

# Tuning (optional)
SYNC_BATCH_SIZE=100
SYNC_README_MAX_LENGTH=10000
SYNC_README_FETCH_CONCURRENCY=6
SYNC_LLM_ENHANCEMENT_CONCURRENCY=4

# Paths (optional)
# NEBULA_CACHE=data/cache.json.gz
# NEBULA_OUTPUT=frontend/public/data
